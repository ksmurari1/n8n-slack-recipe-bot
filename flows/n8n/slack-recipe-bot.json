{
  "name": "Slack Recipe Bot - Template",
  "nodes": [
    {
      "parameters": {
        "trigger": [
          "message"
        ],
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.slackTrigger",
      "typeVersion": 1,
      "position": [
        -848,
        -80
      ],
      "id": "slack-trigger-node",
      "name": "Slack Trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "human-bot-check",
              "leftValue": "={{ $json.bot_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            },
            {
              "id": "human-subtype-check",
              "leftValue": "={{ $json.subtype }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -528,
        -64
      ],
      "id": "if-human-message",
      "name": "If"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "recipe-field",
              "name": "recipe",
              "value": "={{ $json.text.replace(/[\\\"“”]/g, '').trim() }}",
              "type": "string"
            },
            {
              "id": "channel-field",
              "name": "channel",
              "value": "={{ $json.channel }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -320,
        -224
      ],
      "id": "edit-fields-node",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=The user typed this in Slack: {{ $json.recipe }}\n\nFollow these rules in order:\n\n1. If the text is a greeting, a single letter, or a very short message that is not a dish (for example: h, hi, hello, hey, ok, thanks), reply only with: \\\"Could you please specify the recipe or dish you want the ingredient list for?\\\"\n\n2. If the text is gibberish or is clearly not the name of a real dish or recipe (for example: asdfgh, chennai), reply only with: \\\"I couldn't understand that recipe name. Please type a dish name, for example: Paneer Butter Masala.\\\"\n\n3. Otherwise, list all the products and ingredients needed to make that dish. Return a clear bulleted list with approximate quantities (for 4 servings). Keep it short and practical.\nFormat for Slack: use single asterisks for bold, \\\"•\\\" for bullets, and no markdown headings or double asterisks.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -128,
        0
      ],
      "id": "basic-llm-chain",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        208,
        144
      ],
      "id": "openai-chat-model",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Edit Fields').item.json.channel }}",
          "mode": "id"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        272,
        -80
      ],
      "id": "slack-send-message",
      "name": "Send a message"
    }
  ],
